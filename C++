Մուտ քա գրել x թիվը, ստ ա նա լ3֊ից մինչև x Թ իվը նեռա րյա լ բոլոր 7֊ի պ ա տ իկ
թվերի գումա րը/ա րտ ա դրյա լը/քա նա կը  while֊ով։


#include <iostream>
using namespace std;
int main()
{
    int x,i=7,s=0,c=0;
    long long p=1;
    cin>>x;
    while(i<x)
    {
        s=s+i;  //s+=i 
        p=p*i;  //p*=i
        c=c+1;  //c++,++c,c+=1
        cout<<i<< "\n";
        i=i+7;
        
    }
        cout<<"s="<<s<<endl;
        cout<<"p="<<p<<endl;
        cout<<"c="<<c<<endl;
}
        

Մուտ քա գրել x թիվը, ստ ա նա լ1֊ից մինչև x Թ իվը նեռա րյա լ բոլոր 7֊ի պ ա տ իկ
թվերի գումա րը/ա րտ ա դրյա լը/քա նա կը  for֊ով։




#include <iostream>
using namespace std;
int main()
{
    int x,i,s=0,c=0;
    long long p=1;
    cin>>x;
    for(i=7;i<x;i=i+7)
    {
        s=s+i;  //s+=i 
        p=p*i;  //p*=i
        c=c+1;  //c++,++c,c+=1
        cout<<i<< "\n";
        
        
    }
        cout<<"s="<<s<<endl;
        cout<<"p="<<p<<endl;
        cout<<"c="<<c<<endl;
}





Ստ ա նա լբոլոր երկնիշ թվերի 5֊ին պ ա տ իկ թվերի քա նա կը for-ով։


#include <iostream>
using namespace std;
int main()
{
    int i,c=0;
    for(i=10;i<100;i=i+5)
    {
         c=c+1;  
        cout<<i<< "\n";
    }
      cout<<"c="<<c<<endl;
}







Ստ ա նա լբոլոր երկնիշ թվերի 5֊ին պ ա տ իկ թվերի քա նա կը while-ով



#include <iostream>
using namespace std;
int main()
{
    int i=10,c=0;
    while(i<100)
    {
         c=c+1;  
        cout<<i<< "\n";
